{
  "name": "vervo-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Demo navegable de VERVO con práctica guiada y progreso local.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "setup:check": "node scripts/verify-setup.mjs",
    "tools:prepare": "node scripts/prepare-impeccable.mjs",
    "tools:context": "node scripts/impeccable-skill.mjs context",
    "browsers:install": "node scripts/playwright.mjs install chromium firefox webkit",
    "browsers:deps:debian": "python3 scripts/install-debian-browser-libs.py",
    "test": "node scripts/playwright.mjs test --config=playwright.app.config.mjs",
    "test:setup": "node scripts/playwright.mjs test --project=chromium-desktop --project=chromium-mobile",
    "test:report": "node scripts/playwright.mjs show-report work/playwright-report",
    "preview:setup": "node scripts/serve-setup.mjs --host=0.0.0.0",
    "skills:emil": "skills add https://github.com/emilkowalski/skills/tree/4061b67b8d976a186aca118594f54b638c5f718a --skill emil-design-eng choreograph review-animations animation-performance --agent claude-code --copy --yes",
    "skills:impeccable": "node scripts/impeccable.mjs install --providers=claude --scope=project",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:app": "node scripts/playwright.mjs test --config=playwright.app.config.mjs",
    "test:tooling": "node scripts/playwright.mjs test --config=playwright.config.mjs",
    "format": "prettier --write src tests/app index.html tsconfig.json vite.config.ts playwright.app.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "impeccable": "4.8.2",
    "prettier": "3.10.0",
    "skills": "1.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  }
}
