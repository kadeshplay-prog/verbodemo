# La demo navegable no necesita claves ni variables para funcionar.
# Vite: npm run dev -> 5173; npm run preview -> 4174.
# APP_BASE_URL es opcional para Playwright (no es una variable del frontend).
# APP_BASE_URL=http://127.0.0.1:5173
# SETUP_PORT solo afecta a la antigua fixture técnica, no a VERVO.
SETUP_PORT=4173
# Integraciones de producción: autenticación, BD, STT/IA/TTS,
# correo y pagos. Proveedores por elegir; no inventar nombres de variables.
# Sus claves se definirán con cada adaptador, solo del lado servidor.
# No poner tokens de Figma ni de GitHub en el frontend o en Git.
